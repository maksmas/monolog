# Monolog bot environment file. Copy to /etc/monolog-bot/env on the host
# and tighten permissions:
#
#   sudo install -d -m 0750 -o monolog-bot -g monolog-bot /etc/monolog-bot
#   sudo install -m 0600 -o monolog-bot -g monolog-bot env.example /etc/monolog-bot/env
#   sudo $EDITOR /etc/monolog-bot/env
#
# Every value below is required for `monolog telegram serve` to work: the
# token and GIT_SSH_COMMAND/MONOLOG_DIR to start, and all four GIT_* identity
# vars for any write (capture / done / note) to commit successfully.

# Token from @BotFather. Treat as a password.
MONOLOG_TELEGRAM_TOKEN=

# Point git at the host-local SSH deploy key so pull/push uses the right
# credentials regardless of the bot user's ~/.ssh contents.
# StrictHostKeyChecking=no is acceptable here because the only host we ever
# talk to is github.com via a fixed key. UserKnownHostsFile=/dev/null keeps
# ssh from trying to write ~/.ssh/known_hosts — under the systemd unit's
# ProtectHome= read-only setting that write would fail and abort the pull.
GIT_SSH_COMMAND=ssh -i /etc/monolog-bot/id_ed25519 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null

# Where the bot's clone of the tasks repo lives. The monolog binary expects
# <MONOLOG_DIR>/.monolog/config.json to exist with the "telegram" block
# populated (allowed_user_ids at minimum).
MONOLOG_DIR=/home/monolog-bot/tasks-repo

# Git identity for every commit the bot lands. REQUIRED — without these,
# every capture/done/active/note write fails at `git commit` with
# `fatal: empty ident name (for <bot@...>) not allowed`, and the bot
# replies with the canned "sync conflict" toast even though there is no
# real conflict. The systemd unit uses `ProtectHome=read-only` which
# makes `git config --global` from inside the service inconvenient, so
# we pin the identity via env vars instead. All four are required: the
# AUTHOR pair is what shows in the commit log; the COMMITTER pair is
# what git's plumbing uses for the commit object itself. Skipping the
# COMMITTER pair makes git fall back to user.email/user.name which the
# bot user does not have.
GIT_AUTHOR_NAME=monolog-bot
GIT_AUTHOR_EMAIL=bot@yourdomain.tld
GIT_COMMITTER_NAME=monolog-bot
GIT_COMMITTER_EMAIL=bot@yourdomain.tld
