# Monolog bot environment file. Copy to /etc/monolog-bot/env on the host
# and tighten permissions:
#
#   sudo install -d -m 0750 -o monolog-bot -g monolog-bot /etc/monolog-bot
#   sudo install -m 0600 -o monolog-bot -g monolog-bot env.example /etc/monolog-bot/env
#   sudo $EDITOR /etc/monolog-bot/env
#
# All three values are required for `monolog telegram serve` to start.

# Token from @BotFather. Treat as a password.
MONOLOG_TELEGRAM_TOKEN=

# Point git at the EC2-local SSH deploy key so pull/push uses the right
# credentials regardless of the bot user's ~/.ssh contents.
# StrictHostKeyChecking=no is acceptable here because the only host we ever
# talk to is github.com via a fixed key.
GIT_SSH_COMMAND=ssh -i /etc/monolog-bot/id_ed25519 -o StrictHostKeyChecking=no

# Where the bot's clone of the tasks repo lives. The monolog binary expects
# <MONOLOG_DIR>/.monolog/config.json to exist with the "telegram" block
# populated (allowed_user_ids at minimum).
MONOLOG_DIR=/home/monolog-bot/tasks-repo
